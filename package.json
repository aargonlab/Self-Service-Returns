{
  "name": "self-service-return",
  "version": "1.0.0",
  "description": "Self-service returns management platform for Shopify merchants — embedded admin app and branded customer portal.",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "config:use": "shopify app config use",
    "deploy": "shopify app deploy",
    "docker-start": "npm run setup && npm run start",
    "generate": "shopify app generate",
    "setup": "prisma generate && prisma migrate deploy",
    "start": "remix-serve ./build/server/index.js",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "typecheck": "tsc --noEmit",
    "shopify": "shopify",
    "prisma": "prisma",
    "env": "shopify app env"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@remix-run/dev": "^2.17.4",
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@remix-run/serve": "^2.17.4",
    "@shopify/app-bridge-react": "^4.2.10",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-api": "^13.0.0",
    "@shopify/shopify-app-remix": "^4.2.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "date-fns": "^3.6.0",
    "isbot": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^3.2.0",
    "vite-tsconfig-paths": "^4.3.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.17.4",
    "@shopify/cli": "^3.94.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "workspaces": []
}
